# Copialo como .env (cp .env.ejemplo .env) y completalo. El .env NO se sube a git.

# El dominio de la tienda, sin https ni www.
DOMINIO=ramtecnologias.com.ar

# Clave de la base de datos. Inventá una larga (por ejemplo con: openssl rand -hex 24).
# Ponela una sola vez antes del primer arranque: si después la cambiás acá, la base sigue con la vieja.
POSTGRES_PASSWORD=
